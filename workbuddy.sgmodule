#!name = WorkBuddy 令牌捕获（Surge 模块）
#!desc = 腾讯 WorkBuddy 长效令牌捕获：拦截登录/刷新请求，自动抓取 refresh_token 存入本机。捕获成功后可停用本模块，只保留「WorkBuddy 签到」模块。
#!author = roamout
#!homepage = https://github.com/roamout/workbuddy-qx

# ============================================================
# 安装与使用说明
# ------------------------------------------------------------
# 1. 本模块只负责「捕获令牌」，不含签到。捕获成功后即可停用/删除本模块，
#    只保留「WorkBuddy 签到」模块。
# 2. MITM：需在 Surge 开启「MitM」并安装、信任证书（首次抓 HTTPS 必须）。
# 3. 打开 WorkBuddy App / 微信小程序，退出账号重新登录一次，
#    收到「✅ WorkBuddy 令牌捕获成功」通知即完成。
# 4. 令牌有效期约 60 天，签到脚本会自动滚动续期；只有退出账号或连续 60 天
#    未签到才需要重新装回本模块、再登录一次。
# ============================================================

[Script]
# 1) 刷新令牌接口【请求头】：抓取 X-Refresh-Token
http-request ^https:\/\/copilot\.tencent\.com\/v2\/plugin\/auth\/token\/refresh script-path=https://raw.githubusercontent.com/roamout/workbuddy-qx/main/workbuddy_capture_token.surge.js, requires-body=false, tag=WorkBuddy令牌捕获-请求头

# 2) 域名族下的所有 JSON 响应【响应体】：字段名 + Offline 特征 + 字符串正则三提取
http-response ^https:\/\/copilot\.tencent\.com\/ script-path=https://raw.githubusercontent.com/roamout/workbuddy-qx/main/workbuddy_capture_token.surge.js, requires-body=true, max-size=2097152, tag=WorkBuddy令牌捕获-响应体-copilot
http-response ^https:\/\/[a-z.]*workbuddy\.(cn|com)\/ script-path=https://raw.githubusercontent.com/roamout/workbuddy-qx/main/workbuddy_capture_token.surge.js, requires-body=true, max-size=2097152, tag=WorkBuddy令牌捕获-响应体-workbuddy
http-response ^https:\/\/[a-z.]*codebuddy\.(cn|com)\/ script-path=https://raw.githubusercontent.com/roamout/workbuddy-qx/main/workbuddy_capture_token.surge.js, requires-body=true, max-size=2097152, tag=WorkBuddy令牌捕获-响应体-codebuddy
http-response ^https:\/\/[a-z.]*cloud\.tencent\.com\/ script-path=https://raw.githubusercontent.com/roamout/workbuddy-qx/main/workbuddy_capture_token.surge.js, requires-body=true, max-size=2097152, tag=WorkBuddy令牌捕获-响应体-cloud
http-response ^https:\/\/[a-z.]*myqcloud\.com\/ script-path=https://raw.githubusercontent.com/roamout/workbuddy-qx/main/workbuddy_capture_token.surge.js, requires-body=true, max-size=2097152, tag=WorkBuddy令牌捕获-响应体-myqcloud
http-response ^https:\/\/open\.weixin\.qq\.com\/ script-path=https://raw.githubusercontent.com/roamout/workbuddy-qx/main/workbuddy_capture_token.surge.js, requires-body=true, max-size=2097152, tag=WorkBuddy令牌捕获-响应体-weixin

[MITM]
hostname = %APPEND% copilot.tencent.com, *.workbuddy.cn, *.workbuddy.com, *.codebuddy.cn, *.codebuddy.com, *.cloud.tencent.com, *.myqcloud.com, open.weixin.qq.com
